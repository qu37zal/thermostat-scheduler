{
  "name": "smart-thermostat-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API server for smart thermostat scheduling. Provides REST endpoints for thermostat control, schedule management, and history tracking. Compatible with RTCOA (Radio Thermostat Company of America) WiFi-enabled thermostats such as CT50.",
  "author": "Jeremy Rodgers <qu37zal@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/qu37zal/thermostat-scheduler.git",
    "directory": "backend"
  },
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "build": "tsc",
    "dev": "ts-node-dev src/app.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "release": "npm run test && npm run build"
  },
  "keywords": [
    "thermostat",
    "api",
    "express",
    "typescript",
    "scheduler",
    "backend"
  ],
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.17.1",
    "sqlite": "^5.0.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.5.4"
  }
}
